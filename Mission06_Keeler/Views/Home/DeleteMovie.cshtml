@model Movie

@{
    ViewData["Title"] = "Delete Movie";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-warning shadow-sm">
            <div class="card-body">
                <h2 class="card-title">Confirm Deletion</h2>
                <div class="alert alert-warning mb-4" role="alert">
                    Are you sure you want to remove <strong>@Model.Title</strong> from the database?
                </div>
                <form asp-controller="Home" asp-action="Delete" method="post" class="d-flex gap-2">
                    <input asp-for="MovieId" type="hidden" />
                    <button class="btn btn-danger" type="submit">Delete</button>
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="ViewMovies">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
