@model Movie

@{
    ViewData["Title"] = "Delete Movie";
}
<h2>Confirm Deletion</h2>
<h3>Are you sure you want to remove @Model.Title from the database?</h3>

<form asp-controller="Home" asp-action="Delete" method="post">
    <input asp-for="MovieId" type="hidden"/>
    <button class="btn btn-danger" type="submit">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="ViewMovies">Cancel</a>
</form>