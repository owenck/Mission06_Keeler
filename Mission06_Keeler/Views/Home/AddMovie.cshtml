@model Movie

@{
    ViewData["Title"] = "Add a Movie";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" class="row g-3">
                    <input type="hidden" asp-for="MovieId" />

                    <div class="col-12">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Title" class="form-label">Movie Title</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">Category</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">Select a Category</option>
                            @foreach (Category c in ViewBag.Categories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Year" class="form-label">Year</label>
                        <input asp-for="Year" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Director" class="form-label">Director</label>
                        <input asp-for="Director" class="form-control" />
                        <span asp-validation-for="Director" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Rating" class="form-label">Rating</label>
                        <select asp-for="Rating" class="form-select">
                            <option value="">Select a Rating</option>
                            <option>G</option>
                            <option>PG</option>
                            <option>PG-13</option>
                            <option>R</option>
                        </select>
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Edited" class="form-label">Edited</label>
                        <select asp-for="Edited" class="form-select">
                            <option value="">Select</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                        <span asp-validation-for="Edited" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CopiedToPlex" class="form-label">Copied to Plex</label>
                        <select asp-for="CopiedToPlex" class="form-select">
                            <option value="">Select</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                        <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LentTo" class="form-label">Lent To</label>
                        <input asp-for="LentTo" class="form-control" />
                        <span asp-validation-for="LentTo" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="ViewMovies">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
