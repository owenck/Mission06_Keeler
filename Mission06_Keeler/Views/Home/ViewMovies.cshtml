@model List<Movie>

@{
    ViewData["Title"] = "Movie Collection";
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Year</th>
                <th scope="col">Director</th>
                <th scope="col">Rating</th>
                <th scope="col">Edited</th>
                <th scope="col">Lent to</th>
                <th scope="col">Copied to Plex</th>
                <th scope="col">Notes</th>
                <th scope="col"></th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td class="fw-semibold">@m.Title</td>
                    <td>@m.Year</td>
                    <td>@m.Director</td>
                    <td>@m.Rating</td>
                    <td>
                        @if (m.Edited == true)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>@m.LentTo</td>
                    <td>
                        @if (m.CopiedToPlex == true)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>@m.Notes</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Home" asp-action="Edit" asp-route-id="@m.MovieId">Edit</a>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@m.MovieId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
